# DivvyUp Environment Configuration File

# Server Port & Secret Configuration
PORT=4000
JWT_SECRET=divvyup_production_jwt_super_secret_key_2026

# Google Cloud OAuth 2.0 Credentials
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Apple Developer Portal OAuth Credentials
# Obtain from: https://developer.apple.com/account/resources/identifiers/list/serviceId
APPLE_CLIENT_ID=com.divvyup.app.service
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_KEY_ID=YOUR_APPLE_KEY_ID
APPLE_REDIRECT_URI=https://divvyup.app/api/auth/apple/callback
